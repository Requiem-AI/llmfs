{
  "apply_to_all_files": true,
  "skip_paths": [
    ".git",
    ".llmfs",
    "node_modules",
    "vendor",
    "dist",
    "build",
    "bin",
    "out",
    "coverage",
    ".idea",
    ".vscode",
    ".venv",
    "venv",
    "target",
    ".next",
    ".turbo",
    "*.lock",
    "*.min.js",
    "*.map",
    "*.svg",
    "*.png",
    "*.jpg",
    "*.jpeg",
    "*.webp",
    "*.pdf"
  ],
  "middlewares": [
    {
      "name": "deny_env_dotfiles",
      "enabled": true
    },
    {
      "name": "redirect_env_to_agent",
      "enabled": true
    },
    {
      "name": "codec",
      "enabled": true
    },
    {
      "name": "deny_binary",
      "enabled": false
    }
  ],
  "candidates_file": ".llmfs/candidates.txt"
}
