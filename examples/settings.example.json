{
  "apply_to_all_files": true,
  "skip_paths": [
    ".git",
    ".llmfs",
    "node_modules",
    "vendor",
    "dist",
    "build",
    "bin",
    "out",
    "coverage",
    ".idea",
    ".vscode",
    ".venv",
    "venv",
    "target",
    ".next",
    ".turbo",
    "*.lock",
    "*.min.js",
    "*.map",
    "*.svg",
    "*.png",
    "*.jpg",
    "*.jpeg",
    "*.webp",
    "*.pdf"
  ],
  "available_plugins": [
    "deny_env_dotfiles",
    "redirect_env_to_agent",
    "codec"
  ],
  "candidates_file": ".llmfs/candidates.txt"
}
